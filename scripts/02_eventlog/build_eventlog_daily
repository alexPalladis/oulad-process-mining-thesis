import pandas as pd
import os

# --- Ρυθμίσεις διαδρομών (τρέξε το από scripts/02_eventlog/) ---
RAW = "../../data/raw"
OUT = "../../data/processed"
os.makedirs(OUT, exist_ok=True)

vle = pd.read_csv(f"{RAW}/vle.csv")
info = pd.read_csv(f"{RAW}/studentInfo.csv")
svle = pd.read_csv(f"{RAW}/studentVle.csv")

courses = info[["code_module", "code_presentation"]].drop_duplicates().values.tolist()
print(f"Βρέθηκαν {len(courses)} μαθήματα.")

for module, pres in courses:
    vle_c = vle[(vle.code_module == module) & (vle.code_presentation == pres)]
    info_c = info[(info.code_module == module) & (info.code_presentation == pres)]
    svle_c = svle[(svle.code_module == module) & (svle.code_presentation == pres)]

    ev = svle_c.merge(vle_c[["id_site", "activity_type"]], on="id_site", how="left")
    ev = ev.merge(info_c[["id_student", "final_result"]], on="id_student", how="inner")

    # Ημερήσιο timestamp, σχετικό με την έναρξη του μαθήματος (χρησιμοποιείται μόνο ως
    # σταθερή, τεχνητή ημερομηνία αναφοράς — η ίδια η τιμή "date" του OULAD είναι ήδη
    # η σχετική μετατόπιση σε ημέρες από την έναρξη μαθήματος).
    ev["timestamp"] = pd.to_datetime("2000-01-01") + pd.to_timedelta(ev["date"], unit="D")

    event_log = (ev.groupby(["id_student", "final_result", "activity_type", "timestamp"])
                 .agg(clicks=("sum_click", "sum"))
                 .reset_index())
    event_log = event_log.sort_values(["id_student", "timestamp"])

    fname = f"{OUT}/event_log_{module}_{pres}_daily.csv"
    event_log.to_csv(fname, index=False)
    print(f"{module}-{pres}: {event_log.shape[0]} γεγονότα, "
          f"{event_log.id_student.nunique()} φοιτητές -> {fname}")

print("Ολοκληρώθηκε.")